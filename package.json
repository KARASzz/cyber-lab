{
  "name": "ai-chat-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CYBER//LAB — EdgeOne Makers 与 Google Cloud Run",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "start": "node cloudrun/server.mjs",
    "check": "node --check app.js && node --check cloudrun/server.mjs && node --check scripts/build-static.mjs && tsc --noEmit && npm test && git diff --check",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/unit/*.test.js",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "test:native": "node --import ./tests/support/register.mjs --experimental-strip-types --test tests/unit/*.test.ts tests/contract/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.13.0",
    "pg": "^8.23.1"
  }
}
